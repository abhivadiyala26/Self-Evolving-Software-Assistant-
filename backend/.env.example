# Copy these values into the backend process environment or hosting settings.
# The application does not automatically load .env files.

# Optional private accounts (never commit actual values).
AUTOSRE_ADMIN_EMAIL=admin@example.com
AUTOSRE_ADMIN_PASSWORD=
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
AUTOSRE_SESSION_TTL_DAYS=7

# Local development uses SQLite when DATABASE_URL is unset. Use a managed
# PostgreSQL URL for durable hosted accounts and orders.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
# AUTOSRE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
AUTOSRE_SQLITE_PATH=data/autosre.db

# Comma-separated exact frontend origins.
AUTOSRE_CORS_ORIGINS=http://localhost:5173,https://self-evolving-assistant-zeta.vercel.app

# Monitoring and recovery policy thresholds.
AUTOSRE_WARNING_LATENCY_MS=300
AUTOSRE_CRITICAL_LATENCY_MS=500
AUTOSRE_CRITICAL_ERROR_RATE_PERCENT=20
AUTOSRE_CRITICAL_WINDOW_SECONDS=15
AUTOSRE_SAFE_REPLICA_LIMIT=4
AUTOSRE_AUTOMATIC_RECOVERY_ATTEMPTS=3
AUTOSRE_MAX_AUTOMATIC_IMPACTED_SERVICES=2

# Optional automatic failure sequence for demonstrations (off by default).
AUTOSRE_DEMO_FAILURES_ENABLED=false
AUTOSRE_DEMO_FAILURE_SERVICES=frontend,cartservice,paymentservice,productcatalogservice
AUTOSRE_DEMO_FAILURE_COUNT=4
AUTOSRE_DEMO_START_DELAY_SECONDS=20
AUTOSRE_DEMO_MIN_DOWN_SECONDS=12
AUTOSRE_DEMO_RECOVERY_PAUSE_SECONDS=15
